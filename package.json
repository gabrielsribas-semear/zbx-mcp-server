{
  "name": "zbx-mcp-server",
  "version": "3.0.4",
  "description": "Production-grade MCP server for Zabbix — 90+ tools across 19 categories. Run instantly with npx zbx-mcp-server.",
  "license": "MIT",
  "author": "Han Yong Lim <hanyong.lim@gmail.com>",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "zbx-mcp-server": "bin/zbx-mcp-server.js"
  },
  "files": [
    "bin/",
    "src/api/",
    "src/config.js",
    "src/index.js",
    "src/security/",
    "src/tools/",
    "src/types/",
    "src/utils/",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "MCP_TRANSPORT_MODE=http node src/index.js",
    "start:http-stateless": "MCP_TRANSPORT_MODE=http MCP_SESSION_MANAGEMENT=false node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:http": "MCP_TRANSPORT_MODE=http nodemon src/index.js",
    "build": "tsc",
    "build:clean": "rimraf dist && npm run build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:check": "eslint src/ --max-warnings 0",
    "format": "prettier --write src/**/*.js",
    "format:check": "prettier --check src/**/*.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "security:check": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "docker:build": "docker build -t zbx-mcp-server .",
    "docker:run": "docker run -p 3000:3000 --env-file .env zbx-mcp-server",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "validate": "npm run lint:check && npm run test:ci && npm run security:check",
    "pack:local": "npm pack",
    "prepublishOnly": "npm run lint:check && npm run test:ci",
    "prepare": "husky install || true",
    "precommit": "lint-staged",
    "docker:build-ghcr": "bash docker-build-push.sh",
    "docker:login": "echo $GITHUB_TOKEN | docker login ghcr.io -u $GITHUB_USERNAME --password-stdin"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.3",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "zabbix-utils": "^2.0.2-patch.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.0.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^2.1.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "lint-staged": "^15.0.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.10",
    "supertest": "^6.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "resolutions": {
    "zod": "^3.23.8"
  },
  "overrides": {
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write",
      "jest --findRelatedTests --passWithNoTests"
    ]
  },
  "keywords": [
    "zabbix",
    "monitoring",
    "mcp",
    "model-context-protocol",
    "infrastructure",
    "alerting",
    "api-client",
    "devops",
    "observability",
    "network-monitoring",
    "system-monitoring",
    "enterprise-monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroylim/zabbix-mcp-server-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/leroylim/zabbix-mcp-server-nodejs/issues"
  },
  "homepage": "https://github.com/leroylim/zabbix-mcp-server-nodejs#readme"
}
